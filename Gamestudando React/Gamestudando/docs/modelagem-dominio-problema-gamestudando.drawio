        </mxCell>
        <mxCell id="desempenho" value="&lt;b&gt;DESEMPENHO&lt;/b&gt;&lt;hr&gt;Resultado das atividades, incluindo acertos, erros, tempo de resposta e progresso." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="250" width="260" height="120" as="geometry" />
