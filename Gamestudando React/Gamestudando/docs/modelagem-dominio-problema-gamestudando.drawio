        <mxCell id="subtitulo" value="Representa os principais conceitos do problema educacional, sem detalhar campos técnicos do banco de dados." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
