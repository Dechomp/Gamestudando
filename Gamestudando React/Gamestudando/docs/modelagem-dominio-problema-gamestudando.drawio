        </mxCell>
        <mxCell id="avaliacaoInicial" value="&lt;b&gt;AVALIAÇÃO INICIAL&lt;/b&gt;&lt;hr&gt;Conjunto de questões usado para estimar o nível inicial do estudante." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
