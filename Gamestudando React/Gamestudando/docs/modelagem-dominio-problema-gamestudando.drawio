        <mxCell id="estudante" value="&lt;b&gt;ESTUDANTE&lt;/b&gt;&lt;hr&gt;Criança em fase de alfabetização que realiza atividades, jogos e avaliações para desenvolver aprendizagem." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="professor" value="&lt;b&gt;PROFESSOR&lt;/b&gt;&lt;hr&gt;Usuário que cria tarefas, organiza turmas e acompanha o desempenho dos estudantes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="responsavel" value="&lt;b&gt;RESPONSÁVEL&lt;/b&gt;&lt;hr&gt;Usuário que acompanha a evolução do estudante vinculado à sua conta." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
