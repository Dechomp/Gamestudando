        </mxCell>
        <mxCell id="atividade" value="&lt;b&gt;ATIVIDADE&lt;/b&gt;&lt;hr&gt;Exercício educacional realizado pelo estudante, podendo ser quiz, rima ou jogo educativo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
