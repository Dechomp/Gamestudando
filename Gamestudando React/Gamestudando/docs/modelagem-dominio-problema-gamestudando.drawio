        </mxCell>
        <mxCell id="turma" value="&lt;b&gt;TURMA&lt;/b&gt;&lt;hr&gt;Grupo criado pelo professor para acompanhar vários estudantes em conjunto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4338CA;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
