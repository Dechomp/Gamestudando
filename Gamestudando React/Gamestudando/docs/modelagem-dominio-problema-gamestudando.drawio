        </mxCell>
        <mxCell id="tarefaProfessor" value="&lt;b&gt;TAREFA DO PROFESSOR&lt;/b&gt;&lt;hr&gt;Atividade cadastrada pelo professor para alimentar o conjunto de questões utilizado pelo sistema." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
