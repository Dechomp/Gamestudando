        <mxCell id="dificuldade" value="&lt;b&gt;DIFICULDADE&lt;/b&gt;&lt;hr&gt;Conteúdo, matéria ou tipo de questão em que o estudante apresenta maior necessidade de reforço." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
